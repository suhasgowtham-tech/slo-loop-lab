{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "name": "Injected faults (posted by the harness)",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "slo-loop",
            "fault"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#9085e9",
        "name": "Experiment runs (posted by the harness)",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "slo-loop",
            "run"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "#fab219",
        "name": "SLO burn-rate alerts firing",
        "expr": "ALERTS{alertname=~\"SLOBurn.*\",alertstate=\"firing\"}",
        "step": "10s",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}}",
        "useValueForTime": false
      }
    ]
  },
  "description": "Is the LLM service meeting its SLO, and how much error budget is left? Start here. Source: github.com/suhasgowtham-tech/slo-loop-lab",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "slo-loop"
      ],
      "targetBlank": false,
      "title": "SLO-Loop dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of the error budget not yet spent over the selected time range. 100 % = no bad request, 0 % = the SLO was met exactly, below 0 = the SLO was missed. Budget = (1 - SLO target) x requests.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 0
              },
              {
                "color": "#0ca30c",
                "value": 0.25
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1 - (1 - (sum(increase(slo_good_requests_total[$__range])) / (sum(increase(slo_requests_total[$__range])) > 0))) / scalar(1 - slo:target_ratio)",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "budget left"
        }
      ],
      "title": "Error budget left",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Requests that finished OK and produced the first token within their class threshold, over the selected time range. The target is the red line on the chart below.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "mappings": [],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(slo_good_requests_total[$__range])) / (sum(increase(slo_requests_total[$__range])) > 0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "compliance"
        }
      ],
      "title": "SLO compliance",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "How fast the error budget is being spent right now. 1x = exactly on budget. The bands match the alerts: 2.5x opens a ticket, 6x pages.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#ec835a",
                "value": 2.5
              },
              {
                "color": "#d03b3b",
                "value": 6
              }
            ]
          },
          "unit": "suffix:x",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "slo:burn_rate:request_120s",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "burn"
        }
      ],
      "title": "Burn rate (2 min)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "SLO burn-rate alerts currently firing (SLOBurnFast, SLOBurnSlow, SLOBurnFastToken).",
