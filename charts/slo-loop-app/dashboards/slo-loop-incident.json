        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "ALERTS{alertname=~\"SLOBurn.*\",alertstate=~\"pending|firing\"}",
          "refId": "A",
          "range": true,
          "legendFormat": "{{alertname}} ({{alertstate}})"
        }
      ],
      "title": "Burn-rate alerts",
