    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "In-flight requests beyond the LLM's concurrent slots: requests that are waiting rather than being served.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#ec835a",
                "value": 3
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
