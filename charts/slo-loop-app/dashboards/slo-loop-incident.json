{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "name": "Injected faults (posted by the harness)",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "slo-loop",
            "fault"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#9085e9",
        "name": "Experiment runs (posted by the harness)",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "slo-loop",
            "run"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "#fab219",
        "name": "SLO burn-rate alerts firing",
        "expr": "ALERTS{alertname=~\"SLOBurn.*\",alertstate=\"firing\"}",
        "step": "10s",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}}",
        "useValueForTime": false
      }
    ]
  },
  "description": "What broke, where and since when? Burn rate, alert timeline, stage latency, failure causes and saturation, with fault markers. Source: github.com/suhasgowtham-tech/slo-loop-lab",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "slo-loop"
      ],
      "targetBlank": false,
      "title": "SLO-Loop dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Budget burn rate over 30 seconds. Pages at 6x (with the 2-minute rate also at 6x).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#ec835a",
                "value": 2.5
              },
              {
                "color": "#d03b3b",
                "value": 6
              }
            ]
          },
          "unit": "suffix:x",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "slo:burn_rate:request_30s",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "burn"
        }
      ],
      "title": "Fast burn (30 s)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
